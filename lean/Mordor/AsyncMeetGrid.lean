import Mordor.EqualTimeTwo
import Mordor.FinGenAll

/-!
# The asynchronous meet grid, and the Cut Lemma for finitely generated cuts under DCC (round 26, §34.3z¹⁰⁵)

Response to the brief "asynchronous meet-grid and minimal boundary extraction". `D = ⋃_{i<k} ↓gᵢ`, `F` monotone,
generator orbits `uᵢ(t) = (F gᵢ)^[t] s` from a column `s` contracting for every generator (here `s = ⊤`).
Grid columns `W(t) = ⨅ᵢ uᵢ(tᵢ)`.

* `grid_antitone`, `grid_inside_upward`, `asynchronous_meet_step` (`F m_T (W t) ≤ ⨅_{i∈T} uᵢ(tᵢ+1)`),
  `boundary_predecessor_response` (`F m (W(r - eᵢ)) ≤ W(r)`), `boundary_pairwise_meet` (`W(r-eᵢ) ⊓ W(r-eⱼ) = W(r)`).
* **`cut_fingen_dcc`**: in a bounded lattice with DCC, every cut generated by finitely many elements
  `D = ⋃ᵢ ↓gᵢ` (`⊤ ∉ D`) has a witness. Proof: by DCC every orbit `uᵢ` from `⊤` enters `D` at some step `nᵢ + 1`.
  On the finite lattice `Λ = (∏ᵢ [0, nᵢ+1])ᵒᵈ` (a point `t` stands for `W(t)`), let `D_Λ = {t | W t ∈ D}` and
  `F_Λ(x, y)ᵢ = yᵢ + 1` if `W x ≤ gᵢ`, else `0`. `F_Λ` is monotone. A witness `F_Λ x y ⊑ x` would give
  `F (m_T) (W y) ≤ W(F_Λ x y) ≤ W x ≤ m_T` for `T = {i | W x ≤ gᵢ}` (the asynchronous meet step), a witness of `F`;
  a witness `y ⊑ F_Λ x y` would need `yᵢ + 1 ≤ yᵢ` at a labelled coordinate. So `F_Λ` has no witness, against the
  finite Cut Lemma `FinGen.cut_finite` (Sperner parity, §34.3n).
  This settles the three-generator problem (and every `k`) for DCC lattices; `cut_two` is the case `k = 2`.
-/

namespace Mordor.AsyncGrid
open Finset

set_option linter.unusedSectionVars false

section Grid

variable {α : Type*} [Lattice α] [OrderTop α] {ι : Type*} [Fintype ι]

/-- Grid column `W t = ⨅ᵢ uᵢ (tᵢ)`. -/
def W (u : ι → ℕ → α) (t : ι → ℕ) : α := univ.inf fun i => u i (t i)

theorem W_le (u : ι → ℕ → α) (t : ι → ℕ) (i : ι) : W u t ≤ u i (t i) := inf_le (mem_univ i)

theorem grid_antitone {u : ι → ℕ → α} (hu : ∀ i, Antitone (u i)) {t t' : ι → ℕ} (h : t ≤ t') :
    W u t' ≤ W u t :=
  Finset.le_inf fun i _ => (W_le u t' i).trans (hu i (h i))

theorem grid_inside_upward {InD : α → Prop} (hdown : ∀ x y, x ≤ y → InD y → InD x) {u : ι → ℕ → α}
    (hu : ∀ i, Antitone (u i)) {t t' : ι → ℕ} (h : t ≤ t') (ht : InD (W u t)) : InD (W u t') :=
  hdown _ _ (grid_antitone hu h) ht

/-- **Asynchronous meet step.** For the meet row of any `T`, `F m_T (W t) ≤ ⨅_{i∈T} uᵢ(tᵢ + 1)`. -/
theorem asynchronous_meet_step {F : α → α → α} (hF : ∀ x x' y y', x ≤ x' → y ≤ y' → F x y ≤ F x' y')
    (g : ι → α) {s : α} (T : Finset ι) (t : ι → ℕ) :
    F (T.inf g) (W (fun i m => (F (g i))^[m] s) t) ≤ T.inf fun i => (F (g i))^[t i + 1] s :=
  Finset.le_inf fun i hi => by
    show F (T.inf g) (W (fun i m => (F (g i))^[m] s) t) ≤ (F (g i))^[t i + 1] s
    rw [Function.iterate_succ_apply']
    exact hF _ _ _ _ (Finset.inf_le hi) (W_le _ t i)

variable [DecidableEq ι]

/-- **Boundary predecessor response.** If `rᵢ ≥ 1`, the meet row takes the predecessor column `W(r - eᵢ)` below
`W(r)` (for the generator orbits of a column `s` contracting for every generator). -/
theorem boundary_predecessor_response {F : α → α → α} (hF : ∀ x x' y y', x ≤ x' → y ≤ y' → F x y ≤ F x' y')
    (g : ι → α) {s : α} (hgs : ∀ i, F (g i) s ≤ s) (r : ι → ℕ) {i : ι} (hi : 1 ≤ r i) :
    F (univ.inf g) (W (fun j m => (F (g j))^[m] s) (Function.update r i (r i - 1))) ≤
      W (fun j m => (F (g j))^[m] s) r := by
  refine Finset.le_inf fun j _ => ?_
  have hanti : Antitone fun m => (F (g j))^[m] s :=
    Monotone.antitone_iterate_of_map_le (fun _ _ h => hF _ _ _ _ le_rfl h) (hgs j)
  have hstep := (asynchronous_meet_step hF g univ (Function.update r i (r i - 1))).trans
    (Finset.inf_le (f := fun j => (F (g j))^[Function.update r i (r i - 1) j + 1] s) (mem_univ j))
  refine hstep.trans (hanti ?_)
  by_cases hj : j = i
  · subst hj; simp; omega
  · simp [hj]

/-- **Boundary pairwise meet.** For `i ≠ j`, `W(r - eᵢ) ⊓ W(r - eⱼ) = W(r)` (antitone orbits). -/
theorem boundary_pairwise_meet {u : ι → ℕ → α} (hu : ∀ i, Antitone (u i)) (r : ι → ℕ) {i j : ι} (hij : i ≠ j) :
    W u (Function.update r i (r i - 1)) ⊓ W u (Function.update r j (r j - 1)) = W u r := by
  apply le_antisymm
  · refine Finset.le_inf fun l _ => ?_
    by_cases hl : l = i
    · subst hl
      exact inf_le_of_right_le ((W_le u _ l).trans (le_of_eq (by simp [Function.update_of_ne hij])))
    · exact inf_le_of_left_le ((W_le u _ l).trans (le_of_eq (by simp [hl])))
  · exact le_inf (grid_antitone hu fun l => by
        by_cases hl : l = i
        · subst hl; simp
        · simp [hl])
      (grid_antitone hu fun l => by
        by_cases hl : l = j
        · subst hl; simp
        · simp [hl])

end Grid

section Main

/-- `a ↦ min (a + 1) (m + 1)` on `Fin (m + 2)`. -/
def sc {m : ℕ} (a : Fin (m + 2)) : Fin (m + 2) := if h : (a : ℕ) < m + 1 then ⟨a + 1, by omega⟩ else a

theorem sc_mono {m : ℕ} {a b : Fin (m + 2)} (h : a ≤ b) : sc a ≤ sc b := by
  rw [Fin.le_iff_val_le_val] at h ⊢
  unfold sc
  split_ifs with h1 h2 h2 <;> (try dsimp only) <;> omega

theorem sc_val {m : ℕ} {a : Fin (m + 2)} (h : (a : ℕ) < m + 1) : (sc a : ℕ) = a + 1 := by
  unfold sc; rw [dif_pos h]

/-- **The Cut Lemma for finitely generated cuts in DCC lattices.** -/
theorem cut_fingen_dcc {α : Type*} [Lattice α] [BoundedOrder α] [WellFoundedLT α] {k : ℕ} (hk : 0 < k)
    {F : α → α → α} (hF : ∀ x x' y y', x ≤ x' → y ≤ y' → F x y ≤ F x' y') (g : Fin k → α)
    (htop : ¬ ∃ i, ⊤ ≤ g i) :
    ∃ x, (∃ i, x ≤ g i) ∧ ∃ y, (¬ ∃ i, y ≤ g i) ∧ (F x y ≤ x ∨ y ≤ F x y) := by
  classical
  by_contra hno
  have nw : ∀ x, (∃ i, x ≤ g i) → ∀ y, ¬ (∃ i, y ≤ g i) → ¬ F x y ≤ x ∧ ¬ y ≤ F x y :=
    fun x hx y hy => ⟨fun h => hno ⟨x, hx, y, hy, Or.inl h⟩, fun h => hno ⟨x, hx, y, hy, Or.inr h⟩⟩
  have hent : ∀ i, ∃ n, (∀ m ≤ n, ¬ ∃ j, (F (g i))^[m] ⊤ ≤ g j) ∧ ∃ j, F (g i) ((F (g i))^[n] ⊤) ≤ g j :=
    fun i => Mordor.FGTwo.orbit_end (InD := fun x => ∃ j, x ≤ g j) hF ⟨i, le_rfl⟩ nw ⊤ htop le_top
  choose n _ hin using hent
  set u : Fin k → ℕ → α := fun i m => (F (g i))^[m] ⊤ with hu
  have hanti : ∀ i, Antitone (u i) := fun i =>
    Monotone.antitone_iterate_of_map_le (fun _ _ h => hF _ _ _ _ le_rfl h) le_top
  have huN : ∀ i, ∃ j, u i (n i + 1) ≤ g j := fun i => by
    obtain ⟨j, hj⟩ := hin i
    exact ⟨j, by simp only [hu]; rw [Function.iterate_succ_apply']; exact hj⟩
  -- the finite grid lattice
  let P := ∀ i : Fin k, Fin (n i + 2)
  let Wt : P → α := fun t => W u fun i => (t i : ℕ)
  have Wt_anti : ∀ a b : P, a ≤ b → Wt b ≤ Wt a := fun a b h =>
    grid_antitone hanti fun i => (Fin.le_iff_val_le_val.1 (h i))
  let LS : P → Finset (Fin k) := fun t => univ.filter fun j => Wt t ≤ g j
  have mem_LS : ∀ t j, j ∈ LS t ↔ Wt t ≤ g j := fun t j => by simp [LS]
  let step : P → P → P := fun x y i => if i ∈ LS x then sc (y i) else 0
  let FΛ : Pᵒᵈ → Pᵒᵈ → Pᵒᵈ := fun x y => OrderDual.toDual (step (OrderDual.ofDual x) (OrderDual.ofDual y))
  let DΛ : Set Pᵒᵈ := {x | ∃ j, Wt (OrderDual.ofDual x) ≤ g j}
  have hmono : ∀ x x' y y' : Pᵒᵈ, x ≤ x' → y ≤ y' → FΛ x y ≤ FΛ x' y' := by
    intro x x' y y' hx hy i
    show step (OrderDual.ofDual x') (OrderDual.ofDual y') i ≤ step (OrderDual.ofDual x) (OrderDual.ofDual y) i
    simp only [step]
    by_cases h' : i ∈ LS (OrderDual.ofDual x')
    · have h : i ∈ LS (OrderDual.ofDual x) :=
        (mem_LS _ _).2 ((Wt_anti _ _ hx).trans ((mem_LS _ _).1 h'))
      rw [if_pos h', if_pos h]
      exact sc_mono (hy i)
    · rw [if_neg h']; exact Fin.zero_le _
  have hdown : ∀ x y : Pᵒᵈ, x ≤ y → y ∈ DΛ → x ∈ DΛ := fun x y h ⟨j, hj⟩ =>
    ⟨j, (Wt_anti _ _ h).trans hj⟩
  have hbot : (⊥ : Pᵒᵈ) ∈ DΛ := by
    obtain ⟨j, hj⟩ := huN ⟨0, hk⟩
    refine ⟨j, (W_le u _ ⟨0, hk⟩).trans (le_trans ?_ hj)⟩
    apply le_of_eq; congr 1
  have htopΛ : (⊤ : Pᵒᵈ) ∉ DΛ := by
    rintro ⟨j, hj⟩
    apply htop ⟨j, le_trans (le_of_eq ?_) hj⟩
    show ⊤ = univ.inf fun i => u i (((⊥ : P) i : Fin (n i + 2)) : ℕ)
    symm; apply eq_top_iff.2; exact Finset.le_inf fun i _ => by simp [hu]; rfl
  obtain ⟨x, hx, y, hy, hw⟩ := Mordor.FinGen.cut_finite FΛ hmono DΛ hdown hbot htopΛ
  set a := OrderDual.ofDual x
  set b := OrderDual.ofDual y
  obtain ⟨j0, hj0⟩ := hx
  have hj0T : j0 ∈ LS a := (mem_LS _ _).2 hj0
  have hb : ¬ ∃ j, Wt b ≤ g j := hy
  have hbn : ∀ i, (b i : ℕ) < n i + 1 := fun i => by
    by_contra hge
    have heq : (b i : ℕ) = n i + 1 := by have := (b i).isLt; omega
    obtain ⟨j, hj⟩ := huN i
    exact hb ⟨j, (W_le u _ i).trans (by rw [heq]; exact hj)⟩
  have hstepval : ∀ i ∈ LS a, ((step a b i : Fin (n i + 2)) : ℕ) = b i + 1 := fun i hi => by
    simp only [step, if_pos hi]; exact sc_val (hbn i)
  rcases hw with hw | hw
  · -- F_Λ x y ⊑ x, i.e. a ≤ step a b
    have hle : a ≤ step a b := hw
    set T := LS a
    have hcell : F (T.inf g) (Wt b) ≤ Wt (step a b) := by
      refine Finset.le_inf fun i _ => ?_
      by_cases hi : i ∈ T
      · have := asynchronous_meet_step hF g (s := ⊤) T (fun i => (b i : ℕ))
        refine (this.trans (Finset.inf_le hi)).trans (le_of_eq ?_)
        simp only [hu]; rw [hstepval i hi]
      · have h0 : step a b i = 0 := if_neg hi
        show F (T.inf g) (Wt b) ≤ u i ((step a b i : Fin (n i + 2)) : ℕ)
        rw [h0]; simp [hu]
    have hTm : Wt (step a b) ≤ T.inf g :=
      Finset.le_inf fun j hj => (Wt_anti _ _ hle).trans ((mem_LS _ _).1 hj)
    exact (nw _ ⟨j0, Finset.inf_le hj0T⟩ _ hb).1 (hcell.trans hTm)
  · -- y ⊑ F_Λ x y, i.e. step a b ≤ b
    have hle : step a b ≤ b := hw
    have := Fin.le_iff_val_le_val.1 (hle j0)
    rw [hstepval j0 hj0T] at this
    omega

/-- `cut_two` (and its DCC calibration) recovered as the case `k = 2`. -/
theorem cut_two_of_grid {α : Type*} [Lattice α] [BoundedOrder α] [WellFoundedLT α] {F : α → α → α}
    (hF : ∀ x x' y y', x ≤ x' → y ≤ y' → F x y ≤ F x' y') {p q : α} (htop : ¬ (⊤ ≤ p ∨ ⊤ ≤ q)) :
    ∃ x, (x ≤ p ∨ x ≤ q) ∧ ∃ y, ¬ (y ≤ p ∨ y ≤ q) ∧ (F x y ≤ x ∨ y ≤ F x y) := by
  have e : ∀ z : α, (∃ i, z ≤ ![p, q] i) ↔ (z ≤ p ∨ z ≤ q) := fun z => by
    constructor
    · rintro ⟨i, hi⟩; fin_cases i
      · exact Or.inl hi
      · exact Or.inr hi
    · rintro (h | h)
      · exact ⟨0, h⟩
      · exact ⟨1, h⟩
  obtain ⟨x, hx, y, hy, h⟩ := cut_fingen_dcc (k := 2) (by norm_num) hF ![p, q] (by rw [e]; exact htop)
  exact ⟨x, (e x).1 hx, y, by rw [← e]; exact hy, h⟩

/-- **The three-generator Cut Lemma** (DCC). -/
theorem cut_three {α : Type*} [Lattice α] [BoundedOrder α] [WellFoundedLT α] {F : α → α → α}
    (hF : ∀ x x' y y', x ≤ x' → y ≤ y' → F x y ≤ F x' y') (g : Fin 3 → α) (htop : ¬ ∃ i, ⊤ ≤ g i) :
    ∃ x, (∃ i, x ≤ g i) ∧ ∃ y, (¬ ∃ i, y ≤ g i) ∧ (F x y ≤ x ∨ y ≤ F x y) :=
  cut_fingen_dcc (by norm_num) hF g htop

end Main

end Mordor.AsyncGrid
