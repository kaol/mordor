  clear e2 e3 e4 e5 e6 e7 e8 e9 e10 e11 e12 e13 e14 e15 e16 hw h0 h1 hn H
  bv_decide

/-- The explicit F-terms. -/
def tv4 {α : Type*} [Bot α] [Top α] (F : α → α → α) : ℕ → α
  | 0 => ⊥
  | 1 => ⊤
  | 2 => F (⊥) (⊤)
  | 3 => F (⊥) (F (⊥) (⊤))
  | 4 => F (⊥) (F (⊥) (F (⊥) (⊤)))
  | 5 => F (F (⊥) (F (⊥) (⊤))) (F (⊥) (⊤))
  | 6 => F (F (⊥) (F (⊥) (⊤))) (⊤)
  | 7 => F (F (⊥) (F (⊥) (F (⊥) (⊤)))) (⊤)
  | 8 => F (⊥) (F (F (⊥) (F (⊥) (⊤))) (F (⊥) (⊤)))
  | 9 => F (F (⊥) (F (⊥) (⊤))) (F (F (⊥) (F (⊥) (⊤))) (⊤))
  | 10 => F (F (⊥) (F (⊥) (⊤))) (F (F (⊥) (F (⊥) (⊤))) (F (⊥) (⊤)))
  | 11 => F (F (F (⊥) (F (⊥) (⊤))) (F (⊥) (⊤))) (F (⊥) (⊤))
  | 12 => F (⊥) (F (⊥) (F (⊥) (F (⊥) (⊤))))
  | 13 => F (F (F (⊥) (F (⊥) (⊤))) (F (⊥) (⊤))) (⊤)
  | 14 => F (F (⊥) (F (⊥) (F (⊥) (⊤)))) (F (⊥) (F (⊥) (⊤)))
  | 15 => F (F (⊥) (F (⊥) (F (⊥) (⊤)))) (F (⊥) (⊤))
  | 16 => F (⊥) (F (F (⊥) (F (⊥) (⊤))) (⊤))
  | _ => ⊥

/-- **The Cut Lemma at edge-height ≤ 4.** -/
theorem cut_height4 {α : Type*} [PartialOrder α] [OrderBot α] [OrderTop α] (hn : NoChain α 5)
    (F : α → α → α) (hF : ∀ x x' y y', x ≤ x' → y ≤ y' → F x y ≤ F x' y')
    (D : Set α) (hD : ∀ x y, x ≤ y → y ∈ D → x ∈ D) (hbot : ⊥ ∈ D) (htop : ⊤ ∉ D) :
    ∃ x ∈ D, ∃ y, y ∉ D ∧ (F x y ≤ x ∨ y ≤ F x y) := by
  by_contra hno
  push_neg at hno
  exact cut_of_wlog (fun H hn hw => core4 H hn (tv4 _) rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl hw)
    ⟨hF, hD, hbot, htop, fun x hx y hy => hno x hx y hy⟩ hn

end Mordor.Ground
