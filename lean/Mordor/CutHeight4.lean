import Mordor.GroundCut

/-!
# The Cut Lemma at edge-height ≤ 4 (machine-generated by `experiments/sat/cut_lean.py`)

`core4` refutes the 100 ground clauses of a drat-trim-verified unsat core of the cut theory
`C_4^≤` over 17 F-terms built from `⊥, ⊤` (`experiments/sat/cut_ground.py`); every clause is an instance of a
lemma of `GroundCut.lean`, and `bv_decide` checks the propositional refutation (LRAT, kernel-checked).
`cut_height4`: in every bounded poset with no chain of 6 elements, every monotone `F` and every down-set
`D ∋ ⊥`, `⊤ ∉ D` have a witness cell.
The refutation assumes `F(⊥,⊤) ∉ D`; `cut_of_wlog` (order duality) removes the assumption. Do not edit by hand; regenerate.
-/

namespace Mordor.Ground
set_option maxHeartbeats 0
set_option maxRecDepth 100000

theorem core4 {α : Type*} [PartialOrder α] [OrderBot α] [OrderTop α] {F : α → α → α} {D : Set α}
    (H : CutCx F D) (hn : NoChain α 5) (t : ℕ → α) (h0 : t 0 = ⊥) (h1 : t 1 = ⊤)
    (e2 : t 2 = F (t 0) (t 1))
    (e3 : t 3 = F (t 0) (t 2))
    (e4 : t 4 = F (t 0) (t 3))
    (e5 : t 5 = F (t 3) (t 2))
    (e6 : t 6 = F (t 3) (t 1))
    (e7 : t 7 = F (t 4) (t 1))
    (e8 : t 8 = F (t 0) (t 5))
    (e9 : t 9 = F (t 3) (t 6))
    (e10 : t 10 = F (t 3) (t 5))
    (e11 : t 11 = F (t 5) (t 2))
    (e12 : t 12 = F (t 0) (t 4))
    (e13 : t 13 = F (t 5) (t 1))
    (e14 : t 14 = F (t 4) (t 3))
    (e15 : t 15 = F (t 4) (t 2))
    (e16 : t 16 = F (t 0) (t 6))
    (hw : t 2 ∉ D) : False := by
  have c0 := cl_refl (t 0)
  have c1 := cl_refl (t 1)
  have c2 := cl_rankmax hn (t 1)
  have c3 := cl_dbot H h0
  have c4 := cl_dtop H h1
  have c5 := cl_refl (t 2)
  have c6 := cl_top h1 (t 2)
  have c7 := cl_rank (t 2) (t 1) 4 5 rfl
  have c8 := cl_now2 H e2
  have c9 := cl_wlog hw
  have c10 := cl_refl (t 3)
  have c11 := cl_bot h0 (t 3)
  have c12 := cl_rank0 (t 0) (t 3)
  have c13 := cl_rank (t 3) (t 2) 3 4 rfl
  have c14 := cl_now1 H e3
  have c15 := cl_now2 H e3
  have c16 := cl_mono H e3 e2
  have c17 := cl_refl (t 4)
  have c18 := cl_bot h0 (t 4)
  have c19 := cl_rank0 (t 0) (t 4)
  have c20 := cl_rank (t 4) (t 3) 2 3 rfl
  have c21 := cl_now1 H e4
  have c22 := cl_now2 H e4
  have c23 := cl_mono H e4 e3
  have c24 := cl_refl (t 5)
  have c25 := cl_bot h0 (t 5)
  have c26 := cl_rank (t 3) (t 5) 1 2 rfl
  have c27 := cl_rank (t 3) (t 5) 2 3 rfl
  have c28 := cl_now1 H e5
  have c29 := cl_now2 H e5
  have c30 := cl_mono H e3 e5
  have c31 := cl_refl (t 6)
  have c32 := cl_top h1 (t 6)
  have c33 := cl_rank (t 6) (t 1) 4 5 rfl
  have c34 := cl_down H (t 2) (t 6)
  have c35 := cl_rank (t 5) (t 6) 3 4 rfl
  have c36 := cl_now2 H e6
  have c37 := cl_mono H e2 e6
  have c38 := cl_mono H e5 e6
  have c39 := cl_top h1 (t 7)
  have c40 := cl_rank (t 7) (t 1) 4 5 rfl
  have c41 := cl_now2 H e7
  have c42 := cl_mono H e2 e7
  have c43 := cl_trans (t 2) (t 6) (t 5)
  have c44 := cl_bot h0 (t 8)
  have c45 := cl_rank0 (t 0) (t 8)
  have c46 := cl_rank (t 8) (t 3) 1 2 rfl
  have c47 := cl_now1 H e8
  have c48 := cl_mono H e8 e3
  have c49 := cl_rank (t 5) (t 9) 2 3 rfl
  have c50 := cl_rank (t 9) (t 6) 3 4 rfl
  have c51 := cl_now2 H e9
  have c52 := cl_mono H e5 e9
  have c53 := cl_mono H e9 e6
  have c54 := cl_trans (t 5) (t 9) (t 2)
  have c55 := cl_rank (t 3) (t 10) 1 2 rfl
  have c56 := cl_rank (t 10) (t 5) 2 3 rfl
  have c57 := cl_now1 H e10
  have c58 := cl_now2 H e10
  have c59 := cl_mono H e8 e10
  have c60 := cl_mono H e10 e9
  have c61 := cl_trans (t 10) (t 9) (t 5)
  have c62 := cl_rank (t 5) (t 11) 2 3 rfl
  have c63 := cl_now1 H e11
  have c64 := cl_now2 H e11
  have c65 := cl_mono H e5 e11
  have c66 := cl_bot h0 (t 12)
