import Mordor.Cut
import Std.Tactic.BVDecide

/-!
# Finitely generated cuts (log §34.3m)

A cut `D` (a down-set with `⊥ ∈ D`, `⊤ ∉ D`) is *k × l-generated* by `p : Fin k → α` and `u : Fin l → α` when
`D = ↓{p i}` and `Dᶜ = ↑{u j}`. No chain condition is assumed: the lattice may have infinite chains. For such a cut,
the cells `z(A, B) = F (A.inf p) (B.sup u)` (`A`, `B` nonempty) carry a *labelling*: which `p i` lie above `z`, which
`u j` lie below it. The clause lemmas below are its constraints; a propositional refutation of them for given
`k, l` (generated files `FinGenKL.lean`, checked by `bv_decide`) proves the Cut Lemma for every k × l-generated cut.
-/

namespace Mordor.FinGen
open Classical
set_option linter.unusedSectionVars false

variable {α : Type*} [Lattice α] [BoundedOrder α] {k l : ℕ}

/-- A counterexample to the Cut Lemma whose cut is generated by `p` (below) and `u` (above). -/
structure Cx (F : α → α → α) (D : Set α) (p : Fin k → α) (u : Fin l → α) : Prop where
  mono : ∀ x x' y y', x ≤ x' → y ≤ y' → F x y ≤ F x' y'
  down : ∀ x y, x ≤ y → y ∈ D → x ∈ D
  pD : ∀ i, p i ∈ D
  uD : ∀ j, u j ∉ D
  genD : ∀ x ∈ D, ∃ i, x ≤ p i
  genU : ∀ y, y ∉ D → ∃ j, u j ≤ y
  nowit : ∀ x ∈ D, ∀ y, y ∉ D → ¬ F x y ≤ x ∧ ¬ y ≤ F x y

variable {F : α → α → α} {D : Set α} {p : Fin k → α} {u : Fin l → α}

theorem Cx.inf_mem (H : Cx F D p u) {A : Finset (Fin k)} (hA : A.Nonempty) : A.inf p ∈ D := by
  obtain ⟨i, hi⟩ := hA; exact H.down _ _ (Finset.inf_le hi) (H.pD i)

theorem Cx.sup_nmem (H : Cx F D p u) {B : Finset (Fin l)} (hB : B.Nonempty) : B.sup u ∉ D := by
  obtain ⟨j, hj⟩ := hB; exact fun h => H.uD j (H.down _ _ (Finset.le_sup hj) h)

/-! Clause lemmas: one per constraint of the labelling. -/

theorem cl_amono (H : Cx F D p u) {A A' : Finset (Fin k)} {B B' : Finset (Fin l)} (hA : A' ⊆ A) (hB : B ⊆ B')
    (i : Fin k) :
    (!decide (F (A'.inf p) (B'.sup u) ≤ p i) || decide (F (A.inf p) (B.sup u) ≤ p i)) = true := by
  by_cases h : F (A'.inf p) (B'.sup u) ≤ p i
  · simp [(H.mono _ _ _ _ (Finset.inf_mono hA) (Finset.sup_mono hB)).trans h]
  · simp [h]

theorem cl_bmono (H : Cx F D p u) {A A' : Finset (Fin k)} {B B' : Finset (Fin l)} (hA : A' ⊆ A) (hB : B ⊆ B')
    (j : Fin l) :
    (!decide (u j ≤ F (A.inf p) (B.sup u)) || decide (u j ≤ F (A'.inf p) (B'.sup u))) = true := by
  by_cases h : u j ≤ F (A.inf p) (B.sup u)
  · simp [h.trans (H.mono _ _ _ _ (Finset.inf_mono hA) (Finset.sup_mono hB))]
  · simp [h]

theorem cl_aD (H : Cx F D p u) (z : α) (i : Fin k) : (!decide (z ≤ p i) || decide (z ∈ D)) = true := by
  by_cases h : z ≤ p i
  · simp [H.down _ _ h (H.pD i)]
  · simp [h]

theorem cl_bU (H : Cx F D p u) (z : α) (j : Fin l) : (!decide (u j ≤ z) || !decide (z ∈ D)) = true := by
  by_cases h : u j ≤ z
  · simp only [h, decide_true, Bool.not_true, Bool.false_or, Bool.not_eq_true', decide_eq_false_iff_not]
    exact fun hz => H.uD j (H.down _ _ h hz)
  · simp [h]

/-- No witness of the first kind at the cell: `z` is not below all of `p i, i ∈ A`. -/
theorem nwD (H : Cx F D p u) {A : Finset (Fin k)} {B : Finset (Fin l)} (hA : A.Nonempty) (hB : B.Nonempty)
    (h : ∀ i ∈ A, F (A.inf p) (B.sup u) ≤ p i) : False :=
  (H.nowit _ (H.inf_mem hA) _ (H.sup_nmem hB)).1 (Finset.le_inf h)

/-- No witness of the second kind at the cell: not all `u j, j ∈ B`, are below `z`. -/
theorem nwU (H : Cx F D p u) {A : Finset (Fin k)} {B : Finset (Fin l)} (hA : A.Nonempty) (hB : B.Nonempty)
    (h : ∀ j ∈ B, u j ≤ F (A.inf p) (B.sup u)) : False :=
  (H.nowit _ (H.inf_mem hA) _ (H.sup_nmem hB)).2 (Finset.sup_le h)

/-! List-form clauses (the generator unfolds `List.any` over literal lists with `simp only`). -/

theorem cl_nwD (H : Cx F D p u) {A : Finset (Fin k)} {B : Finset (Fin l)} (hA : A.Nonempty) (hB : B.Nonempty)
    (L : List (Fin k)) (hL : ∀ i, i ∈ L ↔ i ∈ A) :
    (L.any fun i => !decide (F (A.inf p) (B.sup u) ≤ p i)) = true := by
  by_contra hc
  simp only [Bool.not_eq_true, List.any_eq_false, Bool.not_eq_false', decide_eq_true_eq] at hc
  exact nwD H hA hB fun i hi => hc i ((hL i).2 hi)

theorem cl_nwU (H : Cx F D p u) {A : Finset (Fin k)} {B : Finset (Fin l)} (hA : A.Nonempty) (hB : B.Nonempty)
    (L : List (Fin l)) (hL : ∀ j, j ∈ L ↔ j ∈ B) :
    (L.any fun j => !decide (u j ≤ F (A.inf p) (B.sup u))) = true := by
  by_contra hc
  simp only [Bool.not_eq_true, List.any_eq_false, Bool.not_eq_false', decide_eq_true_eq] at hc
  exact nwU H hA hB fun j hj => hc j ((hL j).2 hj)

theorem cl_genD (H : Cx F D p u) (z : α) (L : List (Fin k)) (hL : ∀ i, i ∈ L) :
    (!decide (z ∈ D) || L.any fun i => decide (z ≤ p i)) = true := by
  by_cases hz : z ∈ D
  · obtain ⟨i, hi⟩ := H.genD z hz
    simp only [hz, decide_true, Bool.not_true, Bool.false_or, List.any_eq_true, decide_eq_true_eq]
    exact ⟨i, hL i, hi⟩
  · simp [hz]

theorem cl_genU (H : Cx F D p u) (z : α) (L : List (Fin l)) (hL : ∀ j, j ∈ L) :
    (decide (z ∈ D) || L.any fun j => decide (u j ≤ z)) = true := by
  by_cases hz : z ∈ D
  · simp [hz]
  · obtain ⟨j, hj⟩ := H.genU z hz
    simp only [hz, decide_false, Bool.false_or, List.any_eq_true, decide_eq_true_eq]
    exact ⟨j, hL j, hj⟩

end Mordor.FinGen
