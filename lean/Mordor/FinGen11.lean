import Mordor.FinGen

/-! # The Cut Lemma for 1 × 1-generated cuts (machine-generated by `experiments/fgcut/fg_lean.py`)

`lab11` refutes a minimal unsat core (4 of 6 clauses) of the 1 × 1 labelling; each clause is an
instance of a `FinGen.lean` lemma and `bv_decide` checks the propositional refutation. Do not edit by hand; regenerate. -/

namespace Mordor.FinGen
set_option maxHeartbeats 0
set_option maxRecDepth 100000

theorem lab11 {α : Type*} [Lattice α] [BoundedOrder α] {F : α → α → α} {D : Set α}
    {p : Fin 1 → α} {u : Fin 1 → α} (H : Cx F D p u) : False := by
  have c0 := cl_genD H (F (Finset.inf ({0} : Finset (Fin 1)) p) (Finset.sup ({0} : Finset (Fin 1)) u)) [0] (by decide)
  have c1 := cl_genU H (F (Finset.inf ({0} : Finset (Fin 1)) p) (Finset.sup ({0} : Finset (Fin 1)) u)) [0] (by decide)
  have c2 := cl_nwD H (A := ({0} : Finset (Fin 1))) (B := ({0} : Finset (Fin 1))) ⟨0, by decide⟩ ⟨0, by decide⟩ [0] (by decide)
  have c3 := cl_nwU H (A := ({0} : Finset (Fin 1))) (B := ({0} : Finset (Fin 1))) ⟨0, by decide⟩ ⟨0, by decide⟩ [0] (by decide)
  simp only [List.any_cons, List.any_nil, Bool.or_false] at *
  bv_decide

end Mordor.FinGen
