import Mordor.Height4
import Mordor.CutHeight5

/-!
# CL at edge-height ≤ 5

`CutHeight5.lean` (generated) proves the Cut Lemma in every bounded poset with no chain of seven elements: a
drat-trim-verified unsat core (832 ground clauses over 86 F-terms, under `F(⊥,⊤) ∉ D`, removed by
`cut_of_wlog`) of the ground cut theory, found by the tightness-guided term selection of
`experiments/sat/cut_ground.py` (log §34.3h) and replayed by `bv_decide`.
-/

namespace Mordor
open Ground

variable {α : Type*} [CompleteLattice α]

theorem cut_height5' (hn : NoChain α 6) (G : α →o α →o α) : CutCells G :=
  cutCells_of_poset (fun F hF D hD hb ht => cut_height5 hn F hF D hD hb ht) G

/-- **Semi-CL at edge-height ≤ 5.** -/
theorem semi_height5 (hn : NoChain α 6) (G : α →o α →o α)
    (hsemi : ∀ x, b G (a G x) ≤ a G (b G x)) : m G = n G :=
  semi_of_cut (cutMaps_of_cells (cut_height5' hn G)) hsemi

/-- **CL at edge-height ≤ 5.** -/
theorem cl_height5 (hn : NoChain α 6) (G : α →o α →o α)
    (hc : ∀ x, a G (b G x) = b G (a G x)) : m G = n G :=
  semi_height5 hn G fun x => (hc x).ge

/-! ## Locality: only the subalgebra generated by the bounds matters

The F-subalgebra `⟨⊥, ⊤⟩_F` is a bounded, F-closed subposet, and down-sets restrict to it; so the poset-level Cut
Lemma for it gives a witness in the ambient poset. Hence the Cut Lemma (and semi-CL) holds for `F` on *any*
complete lattice, of any height, as soon as `⟨⊥, ⊤⟩_F` has no chain of seven elements. -/

namespace Ground

/-- The F-terms over `⊥, ⊤`: membership in the subalgebra generated by the bounds. -/
inductive Gen {β : Type*} [Bot β] [Top β] (F : β → β → β) : β → Prop
  | bot : Gen F ⊥
  | top : Gen F ⊤
  | app {x y : β} : Gen F x → Gen F y → Gen F (F x y)

variable {β : Type*} [PartialOrder β] [OrderBot β] [OrderTop β] (F : β → β → β)

/-- The subalgebra `⟨⊥, ⊤⟩_F` as a bounded poset. -/
def Sub := {x : β // Gen F x}

instance : PartialOrder (Sub F) := Subtype.partialOrder _
instance : OrderBot (Sub F) where
  bot := ⟨⊥, Gen.bot⟩
  bot_le x := (bot_le : ⊥ ≤ x.1)
instance : OrderTop (Sub F) where
  top := ⟨⊤, Gen.top⟩
  le_top x := (le_top : x.1 ≤ ⊤)

/-- A poset-level Cut Lemma for `⟨⊥, ⊤⟩_F` gives a witness for `F` itself. -/
theorem cut_of_sub {F : β → β → β} (hF : ∀ x x' y y', x ≤ x' → y ≤ y' → F x y ≤ F x' y')
    (h : ∀ (F' : Sub F → Sub F → Sub F), (∀ x x' y y', x ≤ x' → y ≤ y' → F' x y ≤ F' x' y') →
      ∀ (D : Set (Sub F)), (∀ x y, x ≤ y → y ∈ D → x ∈ D) → ⊥ ∈ D → ⊤ ∉ D →
        ∃ x ∈ D, ∃ y, y ∉ D ∧ (F' x y ≤ x ∨ y ≤ F' x y))
    (D : Set β) (hD : ∀ x y, x ≤ y → y ∈ D → x ∈ D) (hbot : ⊥ ∈ D) (htop : ⊤ ∉ D) :
    ∃ x ∈ D, ∃ y, y ∉ D ∧ (F x y ≤ x ∨ y ≤ F x y) := by
  obtain ⟨x, hx, y, hy, hw⟩ := h (fun x y => ⟨F x.1 y.1, Gen.app x.2 y.2⟩)
    (fun x x' y y' hx hy => (hF _ _ _ _ hx hy : F x.1 y.1 ≤ F x'.1 y'.1))
    {x | x.1 ∈ D} (fun x y hxy hy => hD _ _ hxy hy) hbot htop
  exact ⟨x.1, hx, y.1, hy, hw⟩

/-- **Locality.** If `⟨⊥, ⊤⟩_F` has no chain of seven elements, `F` has a witness for every cut, whatever the
height of the ambient poset. -/
theorem cut_local5 {F : β → β → β} (hF : ∀ x x' y y', x ≤ x' → y ≤ y' → F x y ≤ F x' y')
    (hn : NoChain (Sub F) 6) (D : Set β) (hD : ∀ x y, x ≤ y → y ∈ D → x ∈ D) (hbot : ⊥ ∈ D) (htop : ⊤ ∉ D) :
    ∃ x ∈ D, ∃ y, y ∉ D ∧ (F x y ≤ x ∨ y ≤ F x y) :=
  cut_of_sub hF (fun F' hF' D' hD' hb ht => cut_height5 hn F' hF' D' hD' hb ht) D hD hbot htop

end Ground

/-- **Semi-CL, locally:** on any complete lattice, semi-commutation forces `m = n` for every `G` whose subalgebra
`⟨⊥, ⊤⟩_G` has no chain of seven elements. -/
theorem semi_local5 (G : α →o α →o α) (hn : NoChain (Ground.Sub (fun x y => G x y)) 6)
    (hsemi : ∀ x, b G (a G x) ≤ a G (b G x)) : m G = n G := by
  refine semi_of_cut (cutMaps_of_cells ?_) hsemi
  intro D hD ⟨d, hd⟩ ⟨u, hu⟩
  obtain ⟨x, hx, y, hy, h⟩ := Ground.cut_local5 (F := fun x y => G x y)
    (fun x x' y y' hx hy => (G.mono hx y).trans ((G x').mono hy)) hn D (fun x y h hy => hD h hy)
    (hD bot_le hd) (fun h => hu (hD le_top h))
  exact ⟨x, hx, y, hy, h⟩

end Mordor
