import Mordor.OHCube4Terms
import Mordor.OHCube4L0

/-!
# The orbit-height property at edge-height ≤ 4 by cube-and-conquer (machine-generated by `oh_cert_lean.py`)

The rigid orbit-height theory (`OHCxR`, `OHRigid.top_mem_or_ohCxR`) is refuted by a case tree of 25 leaves:
the boundary-orbit case (first `n` with `⊤ ≤ u_n`, first `m` with `d_m ≤ ⊥`) and, inside the hard cases, 3-way splits
on order atoms of boundary-derived terms (`experiments/sat/oh_cube.py`). Each leaf is a drat-trim-verified core checked
by `bv_decide` (`OHCube4L*.lean`), so the proof uses `Lean.ofReduceBool` and `Lean.trustCompiler`.
-/

namespace Mordor.Ground
set_option maxHeartbeats 0
set_option maxRecDepth 100000
set_option linter.unusedVariables false

theorem ohtree4c {α : Type*} [PartialOrder α] [OrderBot α] [OrderTop α] {F : α → α → α} {M : ℕ → Set α}
    (R : OHCxR F M 4) (hn : NoChain α 5) : False := by
  by_cases q1 : (ohtv4c F) 1 ≤ (ohtv4c F) 2
  · by_cases q2 : (ohtv4c F) 2 ≤ (ohtv4c F) 0
    · exact ohleaf4c_0 R hn (ohtv4c F) rfl rfl rfl q1 q2
    · by_cases q3 : (ohtv4c F) 3 ≤ (ohtv4c F) 0
      · exact ohleaf4c_1 R hn (ohtv4c F) rfl rfl rfl q1 q3 q2
      · by_cases q4 : (ohtv4c F) 4 ≤ (ohtv4c F) 0
        · exact ohleaf4c_2 R hn (ohtv4c F) rfl rfl rfl q1 q4 q3
        · by_cases q5 : (ohtv4c F) 5 ≤ (ohtv4c F) 0
          · exact ohleaf4c_3 R hn (ohtv4c F) rfl rfl rfl q1 q5 q4
          · exact ohleaf4c_4 R hn (ohtv4c F) rfl rfl rfl q1 q5
  · by_cases q6 : (ohtv4c F) 1 ≤ (ohtv4c F) 6
    · by_cases q7 : (ohtv4c F) 2 ≤ (ohtv4c F) 0
      · exact ohleaf4c_5 R hn (ohtv4c F) rfl rfl rfl q6 q1 q7
      · by_cases q8 : (ohtv4c F) 3 ≤ (ohtv4c F) 0
        · exact ohleaf4c_6 R hn (ohtv4c F) rfl rfl rfl rfl q6 q1 q8 q7
        · by_cases q9 : (ohtv4c F) 4 ≤ (ohtv4c F) 0
          · exact ohleaf4c_7 R hn (ohtv4c F) rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl q6 q1 q9 q8
          · by_cases q10 : (ohtv4c F) 5 ≤ (ohtv4c F) 0
            · exact ohleaf4c_8 R hn (ohtv4c F) rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl q6 q1 q10 q9
            · exact ohleaf4c_9 R hn (ohtv4c F) rfl rfl rfl rfl rfl rfl rfl q6 q1 q10
    · by_cases q11 : (ohtv4c F) 1 ≤ (ohtv4c F) 7
      · by_cases q12 : (ohtv4c F) 2 ≤ (ohtv4c F) 0
        · exact ohleaf4c_10 R hn (ohtv4c F) rfl rfl rfl q11 q6 q12
        · by_cases q13 : (ohtv4c F) 3 ≤ (ohtv4c F) 0
          · exact ohleaf4c_11 R hn (ohtv4c F) rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl q11 q6 q13 q12
          · by_cases q14 : (ohtv4c F) 4 ≤ (ohtv4c F) 0
            · exact ohleaf4c_12 R hn (ohtv4c F) rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl q11 q6 q14 q13
            · by_cases q15 : (ohtv4c F) 5 ≤ (ohtv4c F) 0
              · exact ohleaf4c_13 R hn (ohtv4c F) rfl rfl rfl rfl rfl rfl rfl q11 q6 q15 q14
              · exact ohleaf4c_14 R hn (ohtv4c F) rfl rfl rfl rfl rfl rfl rfl q11 q6 q15
      · by_cases q16 : (ohtv4c F) 1 ≤ (ohtv4c F) 18
        · by_cases q17 : (ohtv4c F) 2 ≤ (ohtv4c F) 0
          · exact ohleaf4c_15 R hn (ohtv4c F) rfl rfl rfl q16 q11 q17
          · by_cases q18 : (ohtv4c F) 3 ≤ (ohtv4c F) 0
            · exact ohleaf4c_16 R hn (ohtv4c F) rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl q16 q11 q18 q17
            · by_cases q19 : (ohtv4c F) 4 ≤ (ohtv4c F) 0
              · exact ohleaf4c_17 R hn (ohtv4c F) rfl rfl rfl rfl rfl rfl rfl q16 q11 q19 q18
              · by_cases q20 : (ohtv4c F) 5 ≤ (ohtv4c F) 0
                · exact ohleaf4c_18 R hn (ohtv4c F) rfl rfl rfl rfl rfl rfl rfl rfl q16 q11 q20 q19
                · exact ohleaf4c_19 R hn (ohtv4c F) rfl rfl rfl rfl rfl rfl rfl rfl rfl q16 q11 q20
        · by_cases q21 : (ohtv4c F) 2 ≤ (ohtv4c F) 0
          · exact ohleaf4c_20 R hn (ohtv4c F) rfl rfl rfl q16 q21
          · by_cases q22 : (ohtv4c F) 3 ≤ (ohtv4c F) 0
            · exact ohleaf4c_21 R hn (ohtv4c F) rfl rfl rfl rfl rfl rfl rfl q16 q22 q21
            · by_cases q23 : (ohtv4c F) 4 ≤ (ohtv4c F) 0
              · exact ohleaf4c_22 R hn (ohtv4c F) rfl rfl rfl rfl rfl rfl rfl q16 q23 q22
              · by_cases q24 : (ohtv4c F) 5 ≤ (ohtv4c F) 0
                · exact ohleaf4c_23 R hn (ohtv4c F) rfl rfl rfl rfl rfl rfl rfl rfl rfl q16 q24 q23
                · exact ohleaf4c_24 R hn (ohtv4c F) rfl rfl rfl rfl rfl rfl rfl rfl rfl q16 q24

end Mordor.Ground

namespace Mordor.OrbitHeight
open Mordor Mordor.Ground

universe u

/-- **The orbit-height property at edge-height ≤ 4** (cube-and-conquer certificate `ohtree4c`). -/
theorem ohAt_4c : OHAt.{u} 4 := by
  intro β _ G hn
  rcases top_mem_or_ohCxR (fun H' h => ohAt_of_riseAt fun H'' hH'' => riseAt_le_three (by omega)) hn G with h | R
  · exact h
  · exact (ohtree4c R hn).elim

end Mordor.OrbitHeight
