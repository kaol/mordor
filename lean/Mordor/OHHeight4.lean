/-- **The orbit-height property at edge-height ≤ 4** (via the `bv_decide` certificate `ohcore4`). -/
theorem ohAt_4' : OHAt.{u} 4 := by
  intro β _ G hn
  by_contra hnot
  have O : OHCx (fun x y => G x y) (fun k => Rk G k) 4 :=
    ⟨fun x x' y y' hx hy => (G.mono hx y).trans ((G x').mono hy),
     fun t h => (show t ∈ Set.Iic (⊥ : β) from h),
     fun k t h => Rk_mono (Nat.le_succ k) h,
     fun k s t hst h => Rk_down k hst h,
     fun k x y hx h => mem_succ_of_cell hx le_rfl (Or.inl h),
     fun k x y hx h => mem_succ_of_cell hx le_rfl (Or.inr h),
     hnot⟩
  exact ohcore4 O hn (ohtv4 (fun x y => G x y)) rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl rfl

end Mordor.OrbitHeight
