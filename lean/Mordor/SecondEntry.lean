import Mordor.SideEntry
import Mordor.ColumnOrbitCell

/-!
# The top-layer normal form and SecondEntry for a diagonal-fixed feeder (round 26, §34.3z¹⁶⁵)

ChatGPT brief "The second-entry theorem" (HEAD 71300f9).

* `topLayerEntry_iff_fixed_edge`: for `R_k`, `R_{k+1}` index-tight and `h(z) = k + 1`,
  `z ∈ R_{k+1} ↔ ∃ x ∈ R_k, F x z = x ∨ F x z = z`; `topLayerEntry_iff_cell` is the same with cells
  (`F x z ≤ x ∨ z ≤ F x z`), which needs only `R_k` tight.
* `secondEntry_iff_switching`: the brief's B-to-A switching is *equivalent* to SecondEntry (if `m` is not the sole
  B-entry, the other B-entry is already a second top): it is the target, not a step.
* `row_cell_of_diag_post` (no orbit, no stage): if `x ≤ F x x`, `x < v` and `F x v ≤ v`, the row `x` has a cell in
  `(x, v]` (minimal-height descent along `z ↦ F x z`; nothing about the size of any layer).
* **`secondEntry_of_diag_fixed_feeder`**: SecondEntry holds whenever the feeder is diagonal post-fixed,
  `m' ≤ F m' m'` (with the lower-feeder condition `F m' m ≤ m'` this is `F m' m' = m'`). No uniqueness, no feeder
  identity, no lower-height `OHAt` is used. `secondEntry_of_diag_fixed_feeder_colOrb`: the same from the no-cell
  hypothesis through `colOrb_dichotomy`.
* `secondEntry_of_post_off`, **`secondEntry_of_post_layer`** (whole layer): if *any* height-`k` element of `R_k` is
  diagonal post-fixed (below `m` or not), SecondEntry holds. The remaining case is: **no top of `R_k` is diagonal
  post-fixed** (so the feeder is strictly pre-fixed, `F m' m' < m'`).
* `top_parent_new`: a cell parent of a height-`(k+2)` element is not in `R_k` when `R_{k+1}` is index-tight (tops
  are generated by elements new at the previous stage).
-/

namespace Mordor.OrbitHeight
open Mordor Mordor.Ground Mordor.GapPotential

set_option linter.unusedSectionVars false

universe u

variable {α : Type u} [CompleteLattice α] {F : α →o α →o α}

/-- **Top-layer normal form** (the brief's `topLayerEntry_iff_fixed_edge`). For index-tight `R_k`, `R_{k+1}` and
`h(z) = k + 1`: `z ∈ R_{k+1}` iff some old row `x ∈ R_k` has a fixed edge at `z` (`F x z = x`: B-route, `x = b z`;
`F x z = z`: A-route, `z = a x`). -/
theorem topLayerEntry_iff_fixed_edge {k H : ℕ} (hn : NoChain α (H + 1)) (hk : ∀ z ∈ Rk F k, height H z ≤ k)
    (hall : ∀ z ∈ Rk F (k + 1), height H z ≤ k + 1) {z : α} (hz : height H z = k + 1) :
    z ∈ Rk F (k + 1) ↔ ∃ x ∈ Rk F k, F x z = x ∨ F x z = z := by
  constructor
  · intro h
    rcases mem_succ_iff.1 h with h0 | ⟨x, hx, hxa⟩ | hb
    · have := hk z h0; omega
    · have e : z = a F x := by
        by_contra hne
        have := height_strictMono hn (lt_of_le_of_ne hxa hne)
        have := hall _ (mem_succ_of_a hx le_rfl); omega
      exact ⟨x, hx, Or.inr (e ▸ row_a x)⟩
    · exact ⟨b F z, hb, Or.inl (col_b z)⟩
  · rintro ⟨x, hx, h | h⟩
    · exact mem_succ_of_cell hx le_rfl (Or.inl h.le)
    · exact mem_succ_of_cell hx le_rfl (Or.inr h.ge)

/-- **Top-layer normal form, cell form.** -/
theorem topLayerEntry_iff_cell {k H : ℕ} (hn : NoChain α (H + 1)) (hk : ∀ z ∈ Rk F k, height H z ≤ k)
    (hall : ∀ z ∈ Rk F (k + 1), height H z ≤ k + 1) {z : α} (hz : height H z = k + 1) :
    z ∈ Rk F (k + 1) ↔ ∃ x ∈ Rk F k, F x z ≤ x ∨ z ≤ F x z := by
  refine ⟨fun h => ?_, fun ⟨x, hx, h⟩ => mem_succ_of_cell hx le_rfl h⟩
  obtain ⟨x, hx, h | h⟩ := (topLayerEntry_iff_fixed_edge hn hk hall hz).1 h
  · exact ⟨x, hx, Or.inl h.le⟩
  · exact ⟨x, hx, Or.inr h.ge⟩

/-- SecondEntry: a top-layer element of `R_{k+1}` other than `m`. -/
def SecondEntry (F : α →o α →o α) (H k : ℕ) (m : α) : Prop :=
  ∃ z, z ≠ m ∧ height H z = k + 1 ∧ z ∈ Rk F (k + 1)

/-- **B-to-A switching is SecondEntry.** The brief's switching statement (if `m` is the only B-entry of the top
layer, some old row has an A-fixed edge at a top `z ≠ m`) is equivalent to SecondEntry outright. -/
theorem secondEntry_iff_switching {k H : ℕ} (hn : NoChain α (H + 1)) (hk : ∀ z ∈ Rk F k, height H z ≤ k)
    (hall : ∀ z ∈ Rk F (k + 1), height H z ≤ k + 1) {m : α} :
    SecondEntry F H k m ↔
      ((∀ z, height H z = k + 1 → b F z ∈ Rk F k → z = m) →
        ∃ x ∈ Rk F k, ∃ z, z ≠ m ∧ height H z = k + 1 ∧ F x z = z) := by
  constructor
  · rintro ⟨z, hzm, hz, hzR⟩ hsole
    obtain ⟨x, hx, h | h⟩ := (topLayerEntry_iff_fixed_edge hn hk hall hz).1 hzR
    · exact absurd (hsole z hz (Rk_down k (b_le h.le) hx)) hzm
    · exact ⟨x, hx, z, hzm, hz, h⟩
  · intro hsw
    by_cases hs : ∀ z, height H z = k + 1 → b F z ∈ Rk F k → z = m
    · obtain ⟨x, hx, z, hzm, hz, h⟩ := hsw hs
      exact ⟨z, hzm, hz, mem_succ_of_cell hx le_rfl (Or.inr h.ge)⟩
    · push_neg at hs
      obtain ⟨z, hz, hb, hzm⟩ := hs
      exact ⟨z, hzm, hz, mem_succ_of_b hb⟩

/-- **A diagonal post-fixed row has a cell below every pre-fixed column above it.** If `x ≤ F x x`, `x < v` and
`F x v ≤ v`, then some `z` with `x < z ≤ v` has `F x z ≤ x` or `z ≤ F x z`. Descent along `z ↦ F x z`, which maps
`[x, v]` into itself, by height. -/
theorem row_cell_of_diag_post {H : ℕ} (hn : NoChain α (H + 1)) {x : α} (hx : x ≤ F x x) :
    ∀ (n : ℕ) {v : α}, height H v ≤ n → x < v → F x v ≤ v →
      ∃ z, x < z ∧ z ≤ v ∧ (F x z ≤ x ∨ z ≤ F x z)
  | 0, v, hv, hxv, _ => by have := height_strictMono hn hxv; omega
  | n + 1, v, hv, hxv, hFv => by
      by_cases h1 : F x v ≤ x
      · exact ⟨v, hxv, le_rfl, Or.inl h1⟩
      by_cases h2 : v ≤ F x v
      · exact ⟨v, hxv, le_rfl, Or.inr h2⟩
      have hxg : x < F x v := lt_of_le_not_ge (hx.trans ((F x).mono hxv.le)) h1
      have hgv : F x v < v := lt_of_le_not_ge hFv h2
      have := height_strictMono hn hgv
      obtain ⟨z, hz1, hz2, hz3⟩ := row_cell_of_diag_post hn hx n (by omega) hxg ((F x).mono hFv)
      exact ⟨z, hz1, hz2.trans hgv.le, hz3⟩

/-- **SecondEntry for a diagonal post-fixed feeder.** Let `m' ∈ R_k` with `h(m') = k`, `m' ≤ m`, and
`m' ≤ F m' m'`, and let `y = m ⊔ F m y` be a column fixed point of `m` whose output `w = F m y` is incomparable
with `m` (the no-cell branch of `colOrb_dichotomy`). With `R_{k+1}` index-tight, the row `m'` has a cell in
`(m', w]` (`row_cell_of_diag_post`, `feeder_le_side`), which is a top `z ≠ m` of `R_{k+1}`. -/
theorem secondEntry_of_diag_fixed_feeder {k H : ℕ} (hn : NoChain α (H + 1))
    (hall : ∀ z ∈ Rk F (k + 1), height H z ≤ k + 1) {m' m y : α} (hm' : m' ∈ Rk F k) (hm'k : height H m' = k)
    (hm'm : m' ≤ m) (hpost : m' ≤ F m' m') (hy : m ⊔ F m y = y) (hmw : ¬ m ≤ F m y) (hwm : ¬ F m y ≤ m) :
    SecondEntry F H k m := by
  have hm'y : m' ≤ y := hm'm.trans (le_sup_left.trans hy.le)
  have hm'w : m' ≤ F m y := hpost.trans (((F.mono hm'm) m').trans ((F m).mono hm'y))
  have hlt : m' < F m y := lt_of_le_of_ne hm'w fun e => hwm (e ▸ hm'm)
  obtain ⟨z, hz1, hz2, hz3⟩ :=
    row_cell_of_diag_post hn hpost H (height_le _) hlt (feeder_le_side hm'm hy)
  have hzR := mem_succ_of_cell hm' le_rfl hz3
  have := height_strictMono hn hz1; have := hall z hzR
  exact ⟨z, fun e => hmw (e ▸ hz2), by omega, hzR⟩

/-- The same from the no-cell hypothesis, through `colOrb_dichotomy`. -/
theorem secondEntry_of_diag_fixed_feeder_colOrb [WellFoundedLT α] {k H : ℕ} (hn : NoChain α (H + 1))
    (hall : ∀ z ∈ Rk F (k + 1), height H z ≤ k + 1) {m' m : α} (hm' : m' ∈ Rk F k) (hm'k : height H m' = k)
    (hm'm : m' ≤ m) (hpost : m' ≤ F m' m') (htop : m ≠ ⊤)
    (hnocell : ¬ ∃ y, m < y ∧ (F m y ≤ m ∨ y ≤ F m y)) : SecondEntry F H k m := by
  rcases colOrb_dichotomy (F := F) htop with h | ⟨n, -, hfix, -, hmw, hwm⟩
  · exact (hnocell h).elim
  · exact secondEntry_of_diag_fixed_feeder hn hall hm' hm'k hm'm hpost hfix hmw hwm

/-- **A post-fixed top of `R_k` off `↓m` gives a second top** (no condition on `m`'s row): the row `x` has a cell in
`(x, ⊤]` (`x ≠ ⊤` as `m ∉ R_k`), which is a top of `R_{k+1}` other than `m` because `x ≰ m`. -/
theorem secondEntry_of_post_off {k H : ℕ} (hn : NoChain α (H + 1))
    (hall : ∀ z ∈ Rk F (k + 1), height H z ≤ k + 1) {x m : α} (hx : x ∈ Rk F k) (hxk : height H x = k)
    (hpost : x ≤ F x x) (hxm : ¬ x ≤ m) (hmk : m ∉ Rk F k) : SecondEntry F H k m := by
  have hxt : x < ⊤ := lt_top_iff_ne_top.2 fun e => hmk (Rk_down k le_top (e ▸ hx))
  obtain ⟨z, hz1, -, hz3⟩ := row_cell_of_diag_post hn hpost H (height_le _) hxt le_top
  have hzR := mem_succ_of_cell hx le_rfl hz3
  have := height_strictMono hn hz1; have := hall z hzR
  exact ⟨z, fun e => hxm (e ▸ hz1.le), by omega, hzR⟩

/-- **Whole-layer form.** If `m ∉ R_k` has no interval cell and *some* height-`k` element of `R_k` is diagonal
post-fixed, then SecondEntry holds. So SecondEntry is reduced to the case where **no top of `R_k` is diagonal
post-fixed** (in particular the feeder is strictly pre-fixed, `F m' m' < m'`). -/
theorem secondEntry_of_post_layer [WellFoundedLT α] {k H : ℕ} (hn : NoChain α (H + 1))
    (hall : ∀ z ∈ Rk F (k + 1), height H z ≤ k + 1) {m : α} (hmk : m ∉ Rk F k) (htop : m ≠ ⊤)
    (hnocell : ¬ ∃ y, m < y ∧ (F m y ≤ m ∨ y ≤ F m y))
    (hpost : ∃ x ∈ Rk F k, height H x = k ∧ x ≤ F x x) : SecondEntry F H k m := by
  obtain ⟨x, hx, hxk, hxp⟩ := hpost
  by_cases hxm : x ≤ m
  · exact secondEntry_of_diag_fixed_feeder_colOrb hn hall hx hxk hxm hxp htop hnocell
  · exact secondEntry_of_post_off hn hall hx hxk hxp hxm hmk

/-- **Parents of a top are new.** If `R_{k+1}` is index-tight below `k + 1` (heights `≤ k + 1`) and `h(z) = k + 2`,
every old row `x` with a cell at `z` that generates `z` from `R_{k+1}` lies outside `R_k`: a parent in `R_k` would
put `z` into `R_{k+1}`. (Stated at stage `k + 1` to avoid the `k = 0` predecessor.) -/
theorem top_parent_new {k H : ℕ} (hk1 : ∀ z ∈ Rk F (k + 1), height H z ≤ k + 1) {x z : α}
    (hz : height H z = k + 2) (hcell : F x z ≤ x ∨ z ≤ F x z) : x ∉ Rk F k := fun hx => by
  have := hk1 z (mem_succ_of_cell hx le_rfl hcell); omega

end Mordor.OrbitHeight
