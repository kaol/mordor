import Mordor.Orbit
import Mordor.Reach
import Mordor.RelativeCut
import Mathlib.Order.CompactlyGenerated.Basic

/-!
# Stabilized reachability, the ideal orbit, and finite cross-capture (log §34.3z³⁸)

On a complete lattice `α` with a monotone `F`:
* `R_eq_iUnion_Rk`: `R(F) = ⋃ₖ Rₖ` (the rules are unary, so the down-set orbit reaches `R(F)` at `ω`).
* `sSup_finite_support` / `sInf_finite_support`: under ACC (DCC) every supremum (infimum) is a finite subjoin
  (submeet).
* `sSup_Rk_stable`: under ACC, `⋁ Rₖ` is eventually `⋁ R(F)`; `stable_support`: then `⋁ R(F)` is a finite join of
  elements of one stage.
* `rk_eventually_top`: under ACC and DCC the **ideal orbit always reaches `⊤`**: its limit is a closed principal
  ideal, and principal cuts have witnesses. So `⋁ Rₖ ≤ rₖ` carries no information at the limit; the whole gap is
  whether the orbit stays inside `R(F)`.
* `sSup_R_mem_iff`: `⋁ R(F) ∈ R(F)` iff `R(F) = L` (DCC only).
* `cutMaps_iff_rk_mem`, `cutMaps_iff_kstep`: the Cut Lemma for `F` iff every `rₖ ∈ R(F)` iff `R(F)` is closed under
  the ideal step `κ⁺ r = r ⊔ a r ⊔ ⋁{y | b y ≤ r}`; `orbit_escape`: a counterexample has a first escape, an `r ∈ R(F)`
  with `κ⁺ r = r ⊔ a r ⊔ y₁ ⊔ ⋯ ⊔ yₘ ∉ R(F)`, every joinand in `R(F)`.
* `R_univ_of_cross`: if a finite set `S ∋ ⊥, ⊤` is closed under `F` on `(S ∩ R(F)) × (S ∖ R(F))`, then
  `R(F) = L` (no chain condition; `RelativeCut.cut_cross`). `cutCells_of_finite_Fclosure`: a finite `F`-closure of
  `{⊥, ⊤}` forces Cut, with no `⊓`/`⊔`-closure (strengthens `FinGen.cut_of_finite_closure`).
* `cutCells_of_equivariant`: an order automorphism commuting with `F` with finitely many fixed points forces Cut.
* `crossClosure_infinite`: in a counterexample, the `R(F)`-relative cross-closure of `{⊥, ⊤}` is infinite. It is a
  countable bounded subposet on which `F` is witness-free: every counterexample restricts to a countable
  *poset* counterexample generated by `⊥, ⊤`.
-/

namespace Mordor
open Finset

variable {α : Type*} [CompleteLattice α] {F : α →o α →o α}

/-! ### Finite support -/

theorem sSup_finite_support [WellFoundedGT α] (S : Set α) : ∃ t : Finset α, ↑t ⊆ S ∧ sSup S = t.sup id :=
  CompleteLattice.WellFoundedGT.isSupFiniteCompact α S

theorem sInf_finite_support [WellFoundedLT α] (S : Set α) : ∃ t : Finset α, ↑t ⊆ S ∧ sInf S = t.inf id :=
  CompleteLattice.WellFoundedGT.isSupFiniteCompact αᵒᵈ S

/-! ### The down-set orbit reaches `R(F)` at `ω` -/

theorem Rk_subset_R : ∀ k, Rk F k ⊆ R F
  | 0 => fun x hx => R_closed.1 hx R_closed.2.1
  | k + 1 => by
      rw [Rk_succ]
      rintro x ⟨y, hxy, hy | ⟨z, hz, rfl⟩ | hb⟩
      · exact R_closed.1 hxy (Rk_subset_R k hy)
      · exact R_closed.1 hxy (R_closed.2.2.1 z (Rk_subset_R k hz))
      · exact R_closed.1 hxy (R_closed.2.2.2 y (Rk_subset_R k hb))

theorem Rk_mono {j k : ℕ} (h : j ≤ k) : Rk F j ⊆ Rk F k := by
  induction h with
  | refl => exact le_rfl
  | step _ ih => exact ih.trans (by rw [Rk_succ]; exact subset_step _)

theorem closed_iUnion_Rk : Closed F (⋃ k, Rk F k) := by
  refine ⟨fun x y hxy hy => ?_, Set.mem_iUnion.2 ⟨0, le_rfl⟩, fun x hx => ?_, fun y hy => ?_⟩
  · obtain ⟨k, hk⟩ := Set.mem_iUnion.1 hy; exact Set.mem_iUnion.2 ⟨k, Rk_down k hxy hk⟩
  · obtain ⟨k, hk⟩ := Set.mem_iUnion.1 hx
    exact Set.mem_iUnion.2 ⟨k + 1, by rw [Rk_succ]; exact ⟨a F x, le_rfl, Or.inr (Or.inl ⟨x, hk, rfl⟩)⟩⟩
  · obtain ⟨k, hk⟩ := Set.mem_iUnion.1 hy
    exact Set.mem_iUnion.2 ⟨k + 1, by rw [Rk_succ]; exact ⟨y, le_rfl, Or.inr (Or.inr hk)⟩⟩

/-- **`R(F) = ⋃ₖ Rₖ`.** -/
theorem R_eq_iUnion_Rk : R F = ⋃ k, Rk F k :=
  Set.Subset.antisymm (R_subset closed_iUnion_Rk) (Set.iUnion_subset Rk_subset_R)

/-- **The stage suprema stabilize at `⋁ R(F)`** (ACC). -/
theorem sSup_Rk_stable [WellFoundedGT α] : ∃ N, ∀ n, N ≤ n → sSup (Rk F n) = sSup (R F) := by
  let f : ℕ →o α := ⟨fun k => sSup (Rk F k), fun j k h => sSup_le_sSup (Rk_mono h)⟩
  obtain ⟨N, hN⟩ := WellFoundedGT.monotone_chain_condition f
  have hR : sSup (R F) = sSup (Rk F N) := by
    rw [R_eq_iUnion_Rk, sSup_iUnion]
    refine le_antisymm (iSup_le fun k => ?_) (le_iSup (fun k => sSup (Rk F k)) N)
    rcases le_total k N with h | h
    · exact sSup_le_sSup (Rk_mono h)
    · exact (hN k h).ge
  exact ⟨N, fun n hn => by rw [hR]; exact (hN n hn).symm⟩

/-- **Terminal-stage finite support.** `⋁ R(F)` is a finite join of elements of a single stage. -/
theorem stable_support [WellFoundedGT α] :
    ∃ N, ∃ t : Finset α, ↑t ⊆ Rk F N ∧ sSup (R F) = t.sup id := by
  obtain ⟨N, hN⟩ := sSup_Rk_stable (F := F)
  obtain ⟨t, ht, he⟩ := sSup_finite_support (Rk F N)
  exact ⟨N, t, ht, by rw [← hN N le_rfl, he]⟩

/-! ### The ideal orbit reaches `⊤` -/

theorem le_kstep (r : α) : r ≤ kstep F r := le_sup_left.trans le_sup_left

theorem rk_mono : Monotone (rk F) :=
  monotone_nat_of_le_succ fun k => by rw [rk_succ]; exact le_kstep _

/-- A fixed point of the ideal step is `⊤` (principal cuts have witnesses). -/
theorem eq_top_of_kstep [WellFoundedLT α] {r : α} (hr : kstep F r ≤ r) : r = ⊤ := by
  by_contra hne
  obtain ⟨x, hx, y, hy, hc | hc⟩ := cut_principal_down F r hne
  · exact hy (le_trans (le_sSup (show y ∈ {y | b F y ≤ r} from (b_le hc).trans hx))
      (le_sup_right.trans hr))
  · exact hy (((le_a hc).trans ((a F).mono hx)).trans ((le_sup_right.trans le_sup_left).trans hr))

/-- **The ideal orbit always reaches `⊤`** (ACC and DCC). -/
theorem rk_eventually_top [WellFoundedGT α] [WellFoundedLT α] : ∃ M, rk F M = ⊤ := by
  obtain ⟨M, hM⟩ := WellFoundedGT.monotone_chain_condition (⟨rk F, rk_mono⟩ : ℕ →o α)
  refine ⟨M, eq_top_of_kstep (F := F) ?_⟩
  have := hM (M + 1) (Nat.le_succ M)
  simp only [OrderHom.coe_mk] at this
  exact ((rk_succ M).symm.trans this.symm).le

/-! ### Reformulations of the frontier -/

/-- **`⋁ R(F) ∈ R(F)` iff `R(F) = L`** (DCC). -/
theorem sSup_R_mem_iff [WellFoundedLT α] : sSup (R F) ∈ R F ↔ R F = Set.univ := by
  refine ⟨fun hs => ?_, fun h => h ▸ Set.mem_univ _⟩
  obtain ⟨hD, -, ha, hb⟩ := (R_closed (F := F))
  have htop : sSup (R F) = ⊤ := eq_top_of_kstep (sup_le (sup_le le_rfl (le_sSup (ha _ hs)))
    (sSup_le fun y hy => le_sSup (hb y (hD hy hs))))
  exact Set.eq_univ_of_forall fun u => hD le_top (htop ▸ hs)

theorem R_univ_iff_top_mem : R F = Set.univ ↔ (⊤ : α) ∈ R F :=
  ⟨fun h => h ▸ Set.mem_univ _, fun h => Set.eq_univ_of_forall fun _ => R_closed.1 le_top h⟩

/-- **Cut for `F` iff the ideal orbit stays in `R(F)`.** -/
theorem cutMaps_iff_rk_mem [WellFoundedGT α] [WellFoundedLT α] : CutMaps F ↔ ∀ k, rk F k ∈ R F := by
  rw [cutMaps_iff_R]
  refine ⟨fun h k => h ▸ Set.mem_univ _, fun h => ?_⟩
  obtain ⟨M, hM⟩ := rk_eventually_top (F := F)
  exact R_univ_iff_top_mem.2 (hM ▸ h M)

/-- **Cut for `F` iff `R(F)` is closed under the ideal step.** -/
theorem cutMaps_iff_kstep [WellFoundedGT α] [WellFoundedLT α] :
    CutMaps F ↔ ∀ r ∈ R F, kstep F r ∈ R F := by
  refine ⟨fun h r _ => cutMaps_iff_R.1 h ▸ Set.mem_univ _, fun h => cutMaps_iff_rk_mem.2 fun k => ?_⟩
  induction k with
  | zero => exact R_closed.2.1
  | succ k ih => rw [rk_succ]; exact h _ ih

/-- **The first escape.** In a counterexample some `r ∈ R(F)` has `κ⁺ r ∉ R(F)`, although `κ⁺ r` is the join of
`r`, `a r` and finitely many `y` with `b y ≤ r`, all in `R(F)`. -/
theorem orbit_escape [WellFoundedGT α] [WellFoundedLT α] (h : R F ≠ Set.univ) :
    ∃ r ∈ R F, kstep F r ∉ R F ∧ a F r ∈ R F ∧ ∃ t : Finset α, (∀ y ∈ t, b F y ≤ r ∧ y ∈ R F) ∧
      kstep F r = r ⊔ a F r ⊔ t.sup id := by
  have hn : ¬ CutMaps F := fun hc => h (cutMaps_iff_R.1 hc)
  rw [cutMaps_iff_kstep] at hn
  push_neg at hn
  obtain ⟨r, hr, hk⟩ := hn
  obtain ⟨t, ht, he⟩ := sSup_finite_support {y | b F y ≤ r}
  refine ⟨r, hr, hk, R_closed.2.2.1 r hr, t, fun y hy => ⟨ht hy, ?_⟩, by rw [kstep, he]⟩
  exact R_closed.2.2.2 y (R_closed.1 (ht hy) hr)

/-! ### Finite cross-capture -/

theorem F_mono2 (F : α →o α →o α) : ∀ x x' y y' : α, x ≤ x' → y ≤ y' → F x y ≤ F x' y' :=
  fun _ _ _ _ hx hy => (F.mono hx _).trans ((F _).mono hy)

/-- **Finite `F`-closure ⟹ Cut**, on any complete lattice: no `⊓`/`⊔`-closure needed. -/
theorem cutCells_of_finite_Fclosure (S : Set α) (hS : S.Finite) (hbS : ⊥ ∈ S) (htS : ⊤ ∈ S)
    (hFS : ∀ x ∈ S, ∀ y ∈ S, F x y ∈ S) : CutCells F := by
  intro D hD ⟨d, hd⟩ ⟨u, hu⟩
  obtain ⟨x, hx, y, hy, h⟩ := RelativeCut.cut_cross D (fun x y h hy => hD h hy) (fun ht => hu (hD le_top ht))
    (hD bot_le hd) (fun x y => F x y) (F_mono2 F) S hS hbS htS fun x hx _ y hy _ => hFS x hx y hy
  exact ⟨x, hx, y, hy, h⟩

/-- **Finite cross-capture for `R(F)`.** -/
theorem R_univ_of_cross (S : Set α) (hS : S.Finite) (hbS : ⊥ ∈ S) (htS : ⊤ ∈ S)
    (hcross : ∀ x ∈ S, x ∈ R F → ∀ y ∈ S, y ∉ R F → F x y ∈ S) : R F = Set.univ := by
  by_contra hne
  have htop : (⊤ : α) ∉ R F := fun h => hne (R_univ_iff_top_mem.2 h)
  obtain ⟨hD, h0, ha, hb⟩ := (R_closed (F := F))
  obtain ⟨x, hx, y, hy, hc | hc⟩ := RelativeCut.cut_cross (R F) (fun x y h hy => hD h hy) htop h0
    (fun x y => F x y) (F_mono2 F) S hS hbS htS hcross
  · exact hy (hb y (hD (b_le hc) hx))
  · exact hy (hD (le_a hc) (ha x hx))

variable (F) in
/-- The `R(F)`-relative cross-closure of `{⊥, ⊤}`. -/
def crossClosure : Set α :=
  ⋂₀ {S | ⊥ ∈ S ∧ ⊤ ∈ S ∧ ∀ x ∈ S, x ∈ R F → ∀ y ∈ S, y ∉ R F → F x y ∈ S}

/-- **In a counterexample the cross-closure is infinite.** -/
theorem crossClosure_infinite (h : R F ≠ Set.univ) : (crossClosure F).Infinite := by
  intro hfin
  refine h (R_univ_of_cross (crossClosure F) hfin (Set.mem_sInter.2 fun S hS => hS.1)
    (Set.mem_sInter.2 fun S hS => hS.2.1) fun x hx hxR y hy hyR => Set.mem_sInter.2 fun S hS => ?_)
  exact hS.2.2 x (Set.mem_sInter.1 hx S hS) hxR y (Set.mem_sInter.1 hy S hS) hyR


/-! ### Symmetry: periodic counterexamples are impossible -/

/-- **Equivariant `F` with finitely many fixed points satisfy Cut.** If an order automorphism `σ` commutes with `F`
and fixes only finitely many elements, then `Fix σ` is a finite `F`-closed set containing `⊥, ⊤`. So no
translation-invariant construction whose shift-invariant part is finite (as on `M_ω`, `D_ω`, `E_ω` with `⊥, ⊤` the
only invariant elements) can be a counterexample. Dually, any automorphism of a counterexample fixes its
`F`-generated part pointwise. -/
theorem cutCells_of_equivariant (σ : α ≃o α) (hσ : ∀ x y, F (σ x) (σ y) = σ (F x y))
    (hfin : {x | σ x = x}.Finite) : CutCells F :=
  cutCells_of_finite_Fclosure {x | σ x = x} hfin (OrderIso.map_bot σ) (OrderIso.map_top σ)
    fun x hx y hy => by
      show σ (F x y) = F x y
      rw [← hσ]; rw [show σ x = x from hx, show σ y = y from hy]

end Mordor
